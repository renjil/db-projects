{
  "datasets": [
    {
      "name": "executive_summary",
      "displayName": "Executive Summary",
      "queryLines": [
        "SELECT mtd_sales, mtd_gp, mtd_gp_margin_pct, mtd_vs_budget_pct, ",
        "ytd_sales, ytd_vs_budget_pct, ytd_yoy_growth_pct, mtd_writeoff_value ",
        "FROM renjiharold_demo.store_demo.vw_cfo_executive_summary"
      ]
    },
    {
      "name": "monthly_trend",
      "displayName": "Monthly Trend",
      "queryLines": [
        "SELECT month_date, total_sales, total_gp, gp_margin_pct, ly_sales ",
        "FROM renjiharold_demo.store_demo.vw_cfo_monthly_sales_trend ",
        "ORDER BY month_date"
      ]
    },
    {
      "name": "state_performance",
      "displayName": "State Performance",
      "queryLines": [
        "SELECT state, total_sales, total_gp, gp_margin_pct, vs_budget_pct, ",
        "yoy_growth_pct, transaction_count, store_count ",
        "FROM renjiharold_demo.store_demo.vw_cfo_state_performance"
      ]
    },
    {
      "name": "shrinkage_by_category",
      "displayName": "Shrinkage by Category",
      "queryLines": [
        "SELECT category_name, writeoff_value, writeoff_qty, anomaly_count ",
        "FROM renjiharold_demo.store_demo.vw_cfo_shrinkage_by_category ",
        "ORDER BY writeoff_value DESC"
      ]
    },
    {
      "name": "shrinkage_trend",
      "displayName": "Shrinkage Trend",
      "queryLines": [
        "SELECT month_date, total_writeoff_value, anomaly_count ",
        "FROM renjiharold_demo.store_demo.vw_cfo_shrinkage_summary ",
        "ORDER BY month_date"
      ]
    },
    {
      "name": "inventory_summary",
      "displayName": "Inventory Summary",
      "queryLines": [
        "SELECT total_inventory_value, dead_stock_value, dead_stock_pct, ",
        "oos_count, oos_risk_3d_count, overstock_value, avg_days_of_stock ",
        "FROM renjiharold_demo.store_demo.vw_cfo_inventory_summary"
      ]
    },
    {
      "name": "inventory_by_status",
      "displayName": "Inventory by Status",
      "queryLines": [
        "SELECT stock_status, item_count, inventory_value ",
        "FROM renjiharold_demo.store_demo.vw_cfo_inventory_by_status"
      ]
    },
    {
      "name": "dead_stock_by_category",
      "displayName": "Dead Stock by Category",
      "queryLines": [
        "SELECT category_name, item_count, dead_stock_value, avg_days_since_sale ",
        "FROM renjiharold_demo.store_demo.vw_cfo_dead_stock_by_category ",
        "ORDER BY dead_stock_value DESC"
      ]
    },
    {
      "name": "category_performance",
      "displayName": "Category Performance",
      "queryLines": [
        "SELECT category_name, department, total_sales, total_gp, gp_margin_pct, ",
        "sales_share_pct, gp_share_pct, avg_yoy_sales_growth, vs_budget_pct ",
        "FROM renjiharold_demo.store_demo.vw_cfo_category_performance"
      ]
    },
    {
      "name": "budget_variance",
      "displayName": "Budget Variance",
      "queryLines": [
        "SELECT month_date, month_label, state, actual_sales, budget_sales, ",
        "sales_variance, sales_variance_pct, actual_gp, budget_gp, gp_variance, gp_variance_pct ",
        "FROM renjiharold_demo.store_demo.vw_cfo_budget_variance"
      ]
    },
    {
      "name": "budget_summary",
      "displayName": "Budget Summary",
      "queryLines": [
        "SELECT SUM(actual_sales) as total_actual_sales, SUM(budget_sales) as total_budget_sales, ",
        "SUM(actual_sales) - SUM(budget_sales) as total_sales_variance, ",
        "ROUND((SUM(actual_sales) - SUM(budget_sales)) / NULLIF(SUM(budget_sales), 0) * 100, 2) as total_sales_variance_pct, ",
        "SUM(actual_gp) as total_actual_gp, SUM(budget_gp) as total_budget_gp, ",
        "SUM(actual_gp) - SUM(budget_gp) as total_gp_variance, ",
        "ROUND((SUM(actual_gp) - SUM(budget_gp)) / NULLIF(SUM(budget_gp), 0) * 100, 2) as total_gp_variance_pct ",
        "FROM renjiharold_demo.store_demo.vw_cfo_budget_variance"
      ]
    }
  ],
